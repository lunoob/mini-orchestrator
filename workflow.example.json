{
  "title": "实现用户登录功能",
  "projectDir": "/absolute/path/to/project",
  "issues": [
    {
      "title": "Step 1: Setup database schema",
      "specPath": "/absolute/path/to/specs/db-schema.md",
      "state": "ready"
    },
    {
      "title": "Step 2: Implement API endpoints",
      "specPath": "/absolute/path/to/specs/api-endpoints.md"
    },
    {
      "title": "Step 3: Add frontend integration",
      "specPath": "/absolute/path/to/specs/frontend.md",
      "state": "finish"
    }
  ],
  "maxRounds": {
    "workflow": 4,
    "finalGate": 3
  },
  "enableFinalGate": true,
  "agents": {
    "implementer": {
      "name": "implementer",
      "agent": "cursor",
      "model": "composer"
    },
    "reviewer": {
      "name": "reviewer",
      "agent": "codex",
      "model": "gpt-5.5"
    },
    "gateReviewer": {
      "name": "final-reviewer",
      "agent": "codex",
      "model": "gpt-5.5"
    },
    "gateFixer": {
      "name": "final-fixer",
      "agent": "codex",
      "model": "gpt-5.5"
    }
  },
  "prompts": {
    "implement": "./prompts/implement.md",
    "review": "./prompts/review.md",
    "revise": "./prompts/revise.md",
    "finalReview": "./prompts/final-review.md",
    "finalFix": "./prompts/final-fix.md"
  }
}
